{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noahsark.local/schemas/security/log-query.schema.json",
  "title": "NoahsArk node log query message v1",
  "description": "Control-plane -> node signed read-only log query. Whitelisted sources, relative paths confined to the run root, bounded range/quota, named redaction rules and mandatory audit. Results are returned in receipt.log_query_result chunks. No arbitrary file read and no execution of log content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "message_type",
    "sender_role",
    "message_id",
    "node_id",
    "job_id",
    "lease_id",
    "epoch",
    "nonce",
    "issued_at",
    "expires_at",
    "payload_hash",
    "signature",
    "key_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "protocol_version": {
      "const": "noahsark.node/v1"
    },
    "message_type": {
      "const": "log_query"
    },
    "sender_role": {
      "const": "control_plane"
    },
    "message_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "node_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "payload_hash": {
      "$ref": "#/$defs/sha256"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^cp-ed25519:[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "task_id",
        "revision_id",
        "run_id",
        "cursor",
        "lease_id",
        "epoch",
        "requested_by",
        "purpose",
        "reason_code",
        "sources",
        "path",
        "windows_event",
        "time_range",
        "limits",
        "redaction",
        "approval",
        "delivery",
        "audit"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "pattern": "^lq_[0-9a-f]{32}$"
        },
        "task_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._-]{0,256}$"
        },
        "lease_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "requested_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "purpose": {
          "enum": [
            "triage",
            "verification",
            "audit",
            "support"
          ]
        },
        "reason_code": {
          "enum": [
            "USER_REQUEST",
            "EVIDENCE_VERIFICATION",
            "SECURITY_AUDIT",
            "INCIDENT_TRIAGE",
            "SUPPORT_DIAGNOSTICS"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tool_log",
              "serial_log",
              "results_csv",
              "cases_csv",
              "run_manifest",
              "runner_stdout",
              "runner_stderr",
              "windows_event_log"
            ]
          }
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)[.][.](?:/|$))(?!.*//)(?!.*(?:^|/)[.](?:/|$))(?=.*[.](?:log|txt|json|jsonl|csv|xml)$)[A-Za-z0-9._/-]{1,512}$"
        },
        "windows_event": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "channel",
            "provider",
            "level_max",
            "event_ids"
          ],
          "properties": {
            "channel": {
              "enum": [
                "System",
                "Application",
                "NoahsArk-Agent"
              ]
            },
            "provider": {
              "enum": [
                "Microsoft-Windows-Kernel-PnP",
                "Microsoft-Windows-UserPnp",
                "Microsoft-Windows-Audio",
                "Microsoft-Windows-WER-SystemErrorReporting",
                "NoahsArk-Agent"
              ]
            },
            "level_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "event_ids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            }
          }
        },
        "time_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/timestamp"
            },
            "to": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_lines",
            "max_bytes",
            "chunk_size_bytes",
            "timeout_seconds",
            "follow"
          ],
          "properties": {
            "max_lines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 67108864
            },
            "chunk_size_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 262144
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "follow": {
              "const": false
            }
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "rules",
            "include_raw",
            "allow_privileged_raw"
          ],
          "properties": {
            "profile": {
              "enum": [
                "strict",
                "standard",
                "none"
              ]
            },
            "rules": {
              "type": "array",
              "minItems": 0,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "email",
                  "ipv4",
                  "ipv6",
                  "windows_sid",
                  "username",
                  "hostname",
                  "file_path",
                  "token_like",
                  "phone",
                  "mac_address",
                  "device_serial",
                  "audio_filename",
                  "long_numeric_id"
                ]
              }
            },
            "include_raw": {
              "const": false
            },
            "allow_privileged_raw": {
              "type": "boolean"
            }
          }
        },
        "approval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "approval_ref",
            "approved_by"
          ],
          "properties": {
            "approval_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "approved_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "include_content_sha256"
          ],
          "properties": {
            "mode": {
              "enum": [
                "receipt_chunks"
              ]
            },
            "include_content_sha256": {
              "type": "boolean"
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audit_required",
            "reason_text"
          ],
          "properties": {
            "audit_required": {
              "const": true
            },
            "reason_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "redaction": {
                "properties": {
                  "profile": {
                    "const": "none"
                  }
                },
                "required": [
                  "profile"
                ]
              }
            },
            "required": [
              "redaction"
            ]
          }
        },
        "required": [
          "payload"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "approval": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "sources": {
                "contains": {
                  "const": "windows_event_log"
                }
              }
            },
            "required": [
              "sources"
            ]
          }
        },
        "required": [
          "payload"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "windows_event": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payload": {
            "properties": {
              "redaction": {
                "properties": {
                  "profile": {
                    "const": "none"
                  }
                },
                "required": [
                  "profile"
                ]
              }
            },
            "required": [
              "redaction"
            ]
          }
        },
        "required": [
          "payload"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "redaction": {
                "properties": {
                  "allow_privileged_raw": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
