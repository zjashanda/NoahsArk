{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noahsark.local/schemas/security/stop.schema.json",
  "title": "NoahsArk node STOP message v1",
  "description": "Bidirectional signed STOP. Control-plane STOP requires control-plane signature, nonce and current epoch. Local fail-safe STOP is signed by the node and needs no prior remote authorization. STOP never interrupts an in-flight atomic device action mid-operation by force; it stops at a safe point using fixed routines only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "message_type",
    "sender_role",
    "message_id",
    "node_id",
    "job_id",
    "lease_id",
    "epoch",
    "nonce",
    "issued_at",
    "expires_at",
    "payload_hash",
    "signature",
    "key_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "protocol_version": {
      "const": "noahsark.node/v1"
    },
    "message_type": {
      "const": "stop"
    },
    "sender_role": {
      "enum": [
        "control_plane",
        "node"
      ]
    },
    "message_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "node_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "payload_hash": {
      "$ref": "#/$defs/sha256"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^(ed25519|cp-ed25519):[0-9a-f]{32}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stop_id",
        "trigger",
        "mode",
        "scope",
        "target",
        "reason_code",
        "requested_at",
        "ack_deadline_seconds",
        "finish_current_atomic_action",
        "authorized_by",
        "local_authorization",
        "pending_stop_id"
      ],
      "properties": {
        "stop_id": {
          "type": "string",
          "pattern": "^stop_[0-9a-f]{32}$"
        },
        "trigger": {
          "enum": [
            "operator_request",
            "safety_policy",
            "scope_change",
            "lease_revoked",
            "control_plane_shutdown",
            "local_fail_safe",
            "watchdog",
            "quarantine"
          ]
        },
        "mode": {
          "enum": [
            "graceful",
            "immediate_safe"
          ]
        },
        "scope": {
          "enum": [
            "current_job",
            "all_jobs",
            "node_drain"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job_id",
            "lease_id",
            "epoch"
          ],
          "properties": {
            "job_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "lease_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "epoch": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        },
        "reason_code": {
          "enum": [
            "USER_REQUEST",
            "SAFETY_BOUNDARY",
            "SCOPE_CHANGED",
            "LEASE_LOST",
            "SHUTDOWN",
            "LOCAL_OPERATOR",
            "WATCHDOG",
            "DEVICE_FAULT"
          ]
        },
        "requested_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ack_deadline_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "finish_current_atomic_action": {
          "type": "boolean"
        },
        "authorized_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "local_authorization": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "allowed",
            "basis",
            "operator_present"
          ],
          "properties": {
            "allowed": {
              "const": true
            },
            "basis": {
              "const": "fail_safe_local_stop"
            },
            "operator_present": {
              "type": "boolean"
            }
          }
        },
        "pending_stop_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^stop_[0-9a-f]{32}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sender_role": {
            "const": "control_plane"
          }
        },
        "required": [
          "sender_role"
        ]
      },
      "then": {
        "properties": {
          "key_id": {
            "pattern": "^cp-ed25519:[0-9a-f]{32}$"
          },
          "payload": {
            "properties": {
              "local_authorization": {
                "type": "null"
              },
              "authorized_by": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sender_role": {
            "const": "node"
          }
        },
        "required": [
          "sender_role"
        ]
      },
      "then": {
        "properties": {
          "key_id": {
            "pattern": "^ed25519:[0-9a-f]{32}$"
          },
          "payload": {
            "properties": {
              "local_authorization": {
                "type": "object"
              },
              "authorized_by": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
