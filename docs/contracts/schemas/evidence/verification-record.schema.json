{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.noahsark.local/evidence/verification-record.schema.json",
  "title": "NoahsArk Linux Independent Verification Record v1",
  "description": "Linux-side independent review record. Must not use Windows node reported status as a decision input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "task_id",
    "revision_id",
    "run_id",
    "manifest_id",
    "manifest_digest",
    "verifier",
    "independence",
    "checks",
    "check_counts",
    "recomputed",
    "result",
    "started_at",
    "finished_at",
    "reviewed_at",
    "verification_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "verification_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "verdict_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    },
    "manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "verifier": {
      "$ref": "#/$defs/verifier"
    },
    "independence": {
      "$ref": "#/$defs/independence"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 1
    },
    "check_counts": {
      "$ref": "#/$defs/checkCounts"
    },
    "recomputed": {
      "$ref": "#/$defs/recomputed"
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "default": []
    },
    "non_blocking_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "default": []
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiver"
      },
      "default": []
    },
    "signature": {
      "oneOf": [
        {
          "$ref": "#/$defs/signature"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_digest": {
      "$ref": "#/$defs/digest"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "check_counts": {
            "properties": {
              "failed": {
                "const": 0
              },
              "not_run": {
                "const": 0
              }
            }
          },
          "recomputed": {
            "properties": {
              "manifest_digest_match": {
                "const": true
              },
              "denominator_match": {
                "const": true
              },
              "evidence_digest_mismatches": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "independence": {
            "properties": {
              "node_reported_status_used": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "FAIL"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity",
        "role"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "linux_verifier_service",
            "linux_human_reviewer"
          ]
        },
        "identity": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linux_side",
        "separate_from_node",
        "node_reported_status_used",
        "method"
      ],
      "properties": {
        "linux_side": {
          "const": true
        },
        "separate_from_node": {
          "const": true
        },
        "node_reported_status_used": {
          "const": false
        },
        "verifier_not_submitter": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "method": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "category",
        "result"
      ],
      "properties": {
        "check_id": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "schema",
            "digest",
            "size",
            "provenance",
            "association",
            "required_evidence",
            "denominator",
            "oracle",
            "anomaly",
            "cleanup",
            "occupancy",
            "access",
            "redaction",
            "archive"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "WAIVED"
          ]
        },
        "detail_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "uniqueItems": true,
          "default": []
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "checkCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "not_run",
        "waived"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not_run": {
          "type": "integer",
          "minimum": 0
        },
        "waived": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidenceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "declared_digest",
        "observed_digest",
        "match"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
        "declared_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "match": {
          "type": "boolean"
        }
      }
    },
    "recomputed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "manifest_digest_match",
        "evidence_digests",
        "evidence_digest_mismatches",
        "denominator_recomputed",
        "denominator_match"
      ],
      "properties": {
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_digest_match": {
          "type": "boolean"
        },
        "evidence_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceDigest"
          },
          "default": []
        },
        "evidence_digest_mismatches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "denominator_recomputed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planned",
            "valid",
            "formal"
          ],
          "properties": {
            "planned": {
              "type": "integer",
              "minimum": 0
            },
            "valid": {
              "type": "integer",
              "minimum": 0
            },
            "formal": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "denominator_match": {
          "type": "boolean"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiver_id",
        "scope",
        "reason",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "waiver_id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "residual_risk": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer",
        "key_id",
        "algorithm",
        "signed_at",
        "value"
      ],
      "properties": {
        "signer": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
