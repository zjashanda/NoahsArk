{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noahsark.invalid/contracts/domain/approval.schema.json",
  "title": "NoahsArk Approval",
  "description": "One effective approval binds a specific frozen revision content digest and scope snapshot. V0.0.1 permits self-approval; 'approver != submitter' is an optional policy switch, not a current requirement. Contract version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "task_id",
    "revision_id",
    "submitter_id",
    "approver_id",
    "decision",
    "comment",
    "revision_content_digest",
    "scope_snapshot",
    "self_approval",
    "prevent_self_review",
    "wait_timer_seconds",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "approval_id": { "$ref": "#/$defs/uuid" },
    "task_id": { "$ref": "#/$defs/uuid" },
    "revision_id": { "$ref": "#/$defs/uuid" },
    "submitter_id": { "$ref": "#/$defs/uuid" },
    "approver_id": {
      "$ref": "#/$defs/uuid",
      "description": "May equal submitter_id in V0.0.1 unless prevent_self_review is true."
    },
    "decision": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "REJECTED", "WITHDRAWN", "SUPERSEDED"],
      "description": "Timeout keeps PENDING and escalates; it never auto-rejects."
    },
    "comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Mandatory for every decision, including approval."
    },
    "revision_content_digest": {
      "$ref": "#/$defs/digest",
      "description": "Must equal the frozen revision content_digest at approval time."
    },
    "scope_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_digest",
        "case_ids",
        "oracle_set_digest",
        "device_action_set_digest",
        "budget_digest",
        "evidence_requirement_digest"
      ],
      "properties": {
        "scope_digest": { "$ref": "#/$defs/digest" },
        "case_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        },
        "oracle_set_digest": { "$ref": "#/$defs/digest" },
        "device_action_set_digest": { "$ref": "#/$defs/digest" },
        "budget_digest": { "$ref": "#/$defs/digest" },
        "evidence_requirement_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "self_approval": {
      "type": "boolean",
      "description": "True when approver_id equals submitter_id. The server derives and verifies this value."
    },
    "prevent_self_review": {
      "type": "boolean",
      "description": "Policy switch. When true, an APPROVED decision with self_approval=true must be rejected by the server."
    },
    "wait_timer_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Approval cannot become effective before this delay elapses."
    },
    "effective_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Set when APPROVED as decided_at + wait_timer_seconds; may be in the future. Until now >= effective_at the approval is recorded but not effective for execution."
    },
    "decided_at": { "$ref": "#/$defs/timestamp" },
    "withdrawn_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "superseded_by_approval_id": { "$ref": "#/$defs/uuid" },
    "idempotency_key": { "$ref": "#/$defs/idempotency_key" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "enum": ["APPROVED", "REJECTED", "WITHDRAWN", "SUPERSEDED"] } },
        "required": ["decision"]
      },
      "then": { "required": ["decided_at"] }
    },
    {
      "if": {
        "properties": { "decision": { "const": "APPROVED" } },
        "required": ["decision"]
      },
      "then": { "required": ["effective_at"] }
    },
    {
      "if": {
        "properties": { "decision": { "const": "WITHDRAWN" } },
        "required": ["decision"]
      },
      "then": { "required": ["withdrawn_reason"] }
    },
    {
      "if": {
        "properties": { "decision": { "const": "SUPERSEDED" } },
        "required": ["decision"]
      },
      "then": { "required": ["superseded_by_approval_id"] }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  }
}
