{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noahsark.invalid/contracts/domain/execution-bundle.schema.json",
  "title": "NoahsArk Execution Bundle",
  "description": "Immutable execution package generated, reviewed, versioned and frozen by the Linux control plane. The Windows Node Agent may only verify and execute it, never generate or modify scripts, audio, anomaly rules or verdicts. Contract version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "task_id",
    "revision_id",
    "status",
    "digest",
    "approval_snapshot",
    "layers",
    "artifacts",
    "anomaly_rules",
    "evidence_requirements",
    "device_requirements",
    "run_constraints",
    "created_at",
    "frozen_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0", "description": "Payload schema version (R-01, 2026-10-29). This is a different version axis from the wire reference identifier noahsark.execution-bundle/v1. The two values are never compared and neither may be derived from the other." },
    "bundle_id": { "$ref": "#/$defs/uuid" },
    "task_id": { "$ref": "#/$defs/uuid" },
    "revision_id": { "$ref": "#/$defs/uuid" },
    "status": {
      "type": "string",
      "enum": ["FROZEN", "SUPERSEDED", "REVOKED"]
    },
    "digest": {
      "$ref": "#/$defs/digest",
      "description": "Digest over all business fields except digest and created_at. Immutable after freeze."
    },
    "approval_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "revision_id",
        "revision_content_digest",
        "scope_digest",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "approval_id": { "$ref": "#/$defs/uuid" },
        "revision_id": { "$ref": "#/$defs/uuid" },
        "revision_content_digest": { "$ref": "#/$defs/digest" },
        "scope_digest": { "$ref": "#/$defs/digest" },
        "approved_by": { "$ref": "#/$defs/uuid" },
        "approved_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_base", "project_adapter", "task_definition"],
      "properties": {
        "common_base": { "$ref": "#/$defs/layer" },
        "project_adapter": { "$ref": "#/$defs/layer" },
        "task_definition": { "$ref": "#/$defs/layer" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "relative_path", "digest", "size_bytes", "required", "executable"],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/uuid" },
          "kind": {
            "type": "string",
            "enum": ["script", "audio", "profile", "anomaly_rules", "oracle", "cases", "fixture", "runtime_binding", "adapter", "common_base", "documentation"]
          },
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\.\\.).+$",
            "description": "Run-relative path only. Absolute paths, drive letters, UNC paths, backslashes and '..' are forbidden."
          },
          "digest": { "$ref": "#/$defs/digest" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "required": { "type": "boolean" },
          "executable": {
            "type": "boolean",
            "description": "May be true only for script/adapter artifacts."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "executable": { "const": true } }, "required": ["executable"] },
            "then": {
              "properties": { "kind": { "enum": ["script", "adapter"] } }
            }
          }
        ]
      }
    },
    "anomaly_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_set_id", "version", "digest", "required"],
      "properties": {
        "rule_set_id": { "$ref": "#/$defs/uuid" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "digest": { "$ref": "#/$defs/digest" },
        "required": {
          "const": true,
          "description": "B-5 requires anomaly_rules in every execution bundle."
        }
      }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_evidence_set_digest", "redaction_policy_digest"],
      "properties": {
        "required_evidence_set_digest": { "$ref": "#/$defs/digest" },
        "redaction_policy_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "device_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_ids", "endpoint_set", "runtime_binding"],
      "properties": {
        "capability_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "uniqueItems": true
        },
        "endpoint_set": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Legacy field name (C-04, 2026-10-29): in this domain schema the elements are endpoint_kind capability classes, not endpoint identities. Wire lease.endpoint_set and the occupancy key carry endpoint identities (endpoint_<32hex>). The full structural split into endpoint_kinds vs endpoint_id set is a post-freeze 2.0 candidate; v1.1 keeps the type and documents the mapping so no consumer treats kinds as identities.",
          "items": {
            "type": "string",
            "enum": ["audio_capture", "audio_playback", "serial", "usb", "gpio"]
          }
        },
        "equivalence_group_id": { "$ref": "#/$defs/uuid" },
        "runtime_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "python_version", "lstest_version", "adapter_version"],
          "properties": {
            "os": { "type": "string", "enum": ["windows"] },
            "python_version": { "type": "string", "minLength": 1, "maxLength": 50 },
            "lstest_version": { "type": "string", "minLength": 1, "maxLength": 100 },
            "adapter_version": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        }
      }
    },
    "run_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_modes", "budget_digest", "timeout_policy_digest", "retry_policy_digest"],
      "properties": {
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["static", "smoke", "formal"] }
        },
        "budget_digest": { "$ref": "#/$defs/digest" },
        "timeout_policy_digest": { "$ref": "#/$defs/digest" },
        "retry_policy_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "frozen_at": { "$ref": "#/$defs/timestamp" },
    "superseded_by_bundle_id": { "$ref": "#/$defs/uuid" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "SUPERSEDED" } },
        "required": ["status"]
      },
      "then": { "required": ["superseded_by_bundle_id"] }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_version", "content_digest", "source_refs"],
      "properties": {
        "layer_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "content_digest": { "$ref": "#/$defs/digest" },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref_id", "kind", "digest"],
            "properties": {
              "ref_id": { "$ref": "#/$defs/uuid" },
              "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    }
  }
}
