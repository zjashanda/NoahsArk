{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noahsark.invalid/contracts/domain/revision.schema.json",
  "title": "NoahsArk Revision",
  "description": "Immutable plan/execution-boundary version of a task. Frozen content must never be mutated; any change derives a new revision under the same task_id. Contract version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision_id",
    "task_id",
    "revision_number",
    "change_kind",
    "origin",
    "status",
    "immutable",
    "content_digest",
    "frozen_scope",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "revision_id": { "$ref": "#/$defs/uuid" },
    "task_id": { "$ref": "#/$defs/uuid" },
    "revision_number": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic within the task; displayed as R-<n>."
    },
    "parent_revision_id": {
      "$ref": "#/$defs/uuid",
      "description": "Absent for the initial revision. This is revision lineage, not a successor task."
    },
    "change_kind": {
      "type": "string",
      "enum": ["initial", "clarification", "scope_change", "repair", "regeneration", "knowledge_update"]
    },
    "change_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Required for every non-initial revision: what changed and why."
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_requirements_digest", "delta_refs"],
      "properties": {
        "original_requirements_digest": { "$ref": "#/$defs/digest" },
        "delta_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref_id", "kind", "digest"],
            "properties": {
              "ref_id": { "$ref": "#/$defs/uuid" },
              "kind": {
                "type": "string",
                "enum": ["conversation", "file", "spreadsheet", "form", "template", "internal_repair"]
              },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "FROZEN", "APPROVED", "SUPERSEDED", "REJECTED"]
    },
    "immutable": {
      "type": "boolean",
      "description": "Must be true for FROZEN, APPROVED and SUPERSEDED. Frozen content may not be edited in place."
    },
    "content_digest": {
      "$ref": "#/$defs/digest",
      "description": "Digest over frozen_scope + parent_revision_id + change_kind + origin. Never changes after freeze."
    },
    "frozen_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_digest",
        "test_plan_digest",
        "case_refs",
        "oracle_set_digest",
        "device_action_set_digest",
        "budget_digest",
        "evidence_requirement_digest",
        "artifact_refs",
        "anomaly_rule_set_digest",
        "dependency_versions"
      ],
      "properties": {
        "scope_digest": { "$ref": "#/$defs/digest" },
        "test_plan_digest": { "$ref": "#/$defs/digest" },
        "case_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "case_version", "content_digest"],
            "properties": {
              "case_id": { "$ref": "#/$defs/uuid" },
              "case_version": { "type": "integer", "minimum": 1 },
              "content_digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "oracle_set_digest": { "$ref": "#/$defs/digest" },
        "device_action_set_digest": { "$ref": "#/$defs/digest" },
        "budget_digest": {
          "$ref": "#/$defs/digest",
          "description": "Task-level budget bundle (samples, duration, retries, cost). Numeric values are approved per task."
        },
        "evidence_requirement_digest": { "$ref": "#/$defs/digest" },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "kind", "digest", "size_bytes"],
            "properties": {
              "artifact_id": { "$ref": "#/$defs/uuid" },
              "kind": {
                "type": "string",
                "enum": ["script", "audio", "profile", "anomaly_rules", "oracle", "cases", "fixture", "runtime_binding", "adapter", "common_base", "documentation"]
              },
              "digest": { "$ref": "#/$defs/digest" },
              "size_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "anomaly_rule_set_digest": { "$ref": "#/$defs/digest" },
        "dependency_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "digest"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "version": { "type": "string", "minLength": 1, "maxLength": 100 },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "frozen_at": { "$ref": "#/$defs/timestamp" },
    "approved_at": { "$ref": "#/$defs/timestamp" },
    "approval_id": { "$ref": "#/$defs/uuid" },
    "bundle_id": { "$ref": "#/$defs/uuid" },
    "superseded_by_revision_id": {
      "$ref": "#/$defs/uuid",
      "description": "Newer revision in the same task. Never a successor task."
    },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "change_kind": { "not": { "const": "initial" } } },
        "required": ["change_kind"]
      },
      "then": {
        "required": ["change_reason", "parent_revision_id"]
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["FROZEN", "APPROVED", "SUPERSEDED"] } },
        "required": ["status"]
      },
      "then": {
        "properties": { "immutable": { "const": true } },
        "required": ["frozen_at", "bundle_id"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "APPROVED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["approved_at", "approval_id"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "SUPERSEDED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["superseded_by_revision_id"]
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
