{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noahsark.invalid/contracts/domain/run.schema.json",
  "title": "NoahsArk Run",
  "description": "One independent execution (static, smoke or formal). Communication visibility, device occupancy and execution permit are separate. Heartbeat loss or lease renewal expiry never stops a started run and never releases a device. Contract version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "revision_id",
    "bundle_id",
    "mode",
    "lifecycle_status",
    "execution_status",
    "validity_status",
    "business_verdict",
    "evidence_status",
    "verification_status",
    "communication_state",
    "occupancy_state",
    "execution_permit",
    "formal_denominator_eligible",
    "attempt_ids",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": { "$ref": "#/$defs/uuid" },
    "task_id": { "$ref": "#/$defs/uuid" },
    "revision_id": { "$ref": "#/$defs/uuid" },
    "bundle_id": { "$ref": "#/$defs/uuid" },
    "mode": {
      "type": "string",
      "enum": ["static", "smoke", "formal"],
      "description": "Simulation is not a run mode; simulated/replay evidence is expressed on Attempt.evidence_origin."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["CREATED", "DISPATCHED", "RUNNING", "FINISHING", "COMPLETED", "STOPPED", "ABORTED", "BLOCKED"]
    },
    "execution_status": {
      "type": "string",
      "enum": ["NOT_STARTED", "RUNNING", "COMPLETED", "ABORTED", "SKIPPED"],
      "description": "Axis 1. COMPLETED means execution ended, not PASS."
    },
    "validity_status": {
      "type": "string",
      "enum": ["VALID", "INVALID", "BLOCKED", "UNKNOWN"],
      "description": "Axis 2."
    },
    "business_verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "EXPECTED", "WARN", "NEEDS_REVIEW", "NOT_EVALUATED"],
      "description": "Axis 3. Written only by the Linux control plane."
    },
    "evidence_status": {
      "type": "string",
      "enum": ["COMPLETE", "INCOMPLETE", "CONFLICTED", "UNVERIFIED"],
      "description": "Axis 4."
    },
    "verification_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "NOT_RUN"],
      "description": "Axis 5. Linux independent review; mandatory for formal PASS."
    },
    "node_id": { "$ref": "#/$defs/uuid" },
    "device_id": { "$ref": "#/$defs/uuid" },
    "lease_id": { "$ref": "#/$defs/uuid" },
    "lease_epoch": { "type": "integer", "minimum": 1 },
    "communication_state": {
      "type": "string",
      "enum": ["ONLINE", "STALE", "OFFLINE"],
      "description": "Visibility only. OFFLINE does not mean device idle, run stopped or lease invalid."
    },
    "occupancy_state": {
      "type": "string",
      "enum": ["IDLE", "OCCUPIED", "RELEASING"],
      "description": "Device occupancy, independent of communication state."
    },
    "execution_permit": {
      "type": "string",
      "enum": ["GRANTED", "NOT_GRANTED", "SUSPENDED"],
      "description": "Permission for an already-started job to continue locally. Remains GRANTED while communication is OFFLINE."
    },
    "formal_denominator_eligible": {
      "type": "boolean",
      "description": "Server-derived. True only for a formal run whose samples are valid formal samples. Clients must not supply true for smoke/static/simulated evidence."
    },
    "attempt_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuid" },
      "uniqueItems": true
    },
    "cleanup_receipt_id": {
      "$ref": "#/$defs/uuid",
      "description": "Links device cleanup/release. Missing cleanup receipt means occupancy is unreconciled, not that evidence is incomplete."
    },
    "evidence_manifest_id": { "$ref": "#/$defs/uuid" },
    "stop_requested_at": { "$ref": "#/$defs/timestamp" },
    "stop_reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "failure_classification": {
      "type": "string",
      "enum": [
        "INVALID_INPUT",
        "INVALID_ENVIRONMENT",
        "INVALID_EVIDENCE",
        "VALID_FAILURE",
        "BLOCKED",
        "STOPPED",
        "UNSUPPORTED",
        "INFRA_ERROR"
      ],
      "description": "Authoritative failure vocabulary (C-02, 2026-10-29). These 8 uppercase values are the persisted truth; evidence-side failure_class is a lowercase serialization projection (bidirectional table in domain.md §9.4 and evidence-verdict.md §15.1). No failure is expressed by omitting this field (never by a NONE value). needs-review is not a member here; it is expressed by business_verdict=NEEDS_REVIEW plus non-PASS verification_status. INFRA_ERROR only after reconciliation confirms an infrastructure fault; heartbeat/communication timeout alone must never set it."
    },
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 100
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "last_heartbeat_at": {
      "$ref": "#/$defs/timestamp",
      "description": "Observability only. Must not drive run state or device release."
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "static" } }, "required": ["mode"] },
      "then": {
        "not": { "anyOf": [{ "required": ["node_id"] }, { "required": ["device_id"] }, { "required": ["lease_id"] }, { "required": ["lease_epoch"] }] },
        "properties": { "formal_denominator_eligible": { "const": false } }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "smoke" } }, "required": ["mode"] },
      "then": {
        "required": ["node_id", "device_id", "lease_id", "lease_epoch"],
        "properties": { "formal_denominator_eligible": { "const": false } }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "formal" } }, "required": ["mode"] },
      "then": { "required": ["node_id", "device_id", "lease_id", "lease_epoch"] }
    },
    {
      "if": {
        "properties": { "formal_denominator_eligible": { "const": true } },
        "required": ["formal_denominator_eligible"]
      },
      "then": { "properties": { "mode": { "const": "formal" } } }
    },
    {
      "if": {
        "properties": { "lifecycle_status": { "const": "RUNNING" } },
        "required": ["lifecycle_status"]
      },
      "then": { "required": ["started_at"] }
    },
    {
      "if": {
        "properties": { "lifecycle_status": { "enum": ["COMPLETED", "STOPPED", "ABORTED", "BLOCKED"] } },
        "required": ["lifecycle_status"]
      },
      "then": { "required": ["finished_at"] }
    },
    {
      "if": {
        "properties": { "stop_requested_at": { "type": "string" } },
        "required": ["stop_requested_at"]
      },
      "then": { "required": ["stop_reason"] }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
