{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noahsark.invalid/contracts/domain/attempt.schema.json",
  "title": "NoahsArk Attempt",
  "description": "One case attempt with five independent status axes. Retries create new attempts; the first result is never overwritten. Simulated, replay and smoke evidence can never be denominator eligible. Contract version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "run_id",
    "case_id",
    "case_version",
    "run_mode",
    "attempt_ordinal",
    "execution_status",
    "validity_status",
    "business_verdict",
    "evidence_status",
    "verification_status",
    "evidence_origin",
    "denominator_eligible",
    "flaky_suspect",
    "evidence_ids",
    "anomaly_event_ids",
    "facts",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "attempt_id": { "$ref": "#/$defs/uuid" },
    "run_id": { "$ref": "#/$defs/uuid" },
    "case_id": { "$ref": "#/$defs/uuid" },
    "case_version": { "type": "integer", "minimum": 1 },
    "run_mode": {
      "type": "string",
      "enum": ["static", "smoke", "formal"]
    },
    "attempt_ordinal": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic within the same run and case."
    },
    "execution_status": {
      "type": "string",
      "enum": ["NOT_STARTED", "RUNNING", "COMPLETED", "ABORTED", "SKIPPED"]
    },
    "validity_status": {
      "type": "string",
      "enum": ["VALID", "INVALID", "BLOCKED", "UNKNOWN"]
    },
    "business_verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "EXPECTED", "WARN", "NEEDS_REVIEW", "NOT_EVALUATED"],
      "description": "Written only by the Linux control plane, never by the node."
    },
    "evidence_status": {
      "type": "string",
      "enum": ["COMPLETE", "INCOMPLETE", "CONFLICTED", "UNVERIFIED"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "NOT_RUN"]
    },
    "evidence_origin": {
      "type": "string",
      "enum": ["real_device", "simulated", "replay", "imported"],
      "description": "Simulation is an evidence origin, not a run mode. Formal runs require real_device."
    },
    "denominator_eligible": {
      "type": "boolean",
      "description": "Server-derived. True only for formal + real_device + COMPLETED + VALID + COMPLETE evidence."
    },
    "retry_of_attempt_id": { "$ref": "#/$defs/uuid" },
    "flaky_suspect": {
      "type": "boolean",
      "description": "Set by Linux for retry-passed or unstable behavior; does not overwrite the first attempt."
    },
    "node_id": { "$ref": "#/$defs/uuid" },
    "device_id": { "$ref": "#/$defs/uuid" },
    "receipt_id": { "$ref": "#/$defs/uuid" },
    "evidence_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuid" },
      "uniqueItems": true
    },
    "anomaly_event_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuid" },
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "name", "value_type", "value", "observed_at", "source"],
        "properties": {
          "fact_id": { "$ref": "#/$defs/uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "value_type": { "type": "string", "enum": ["string", "number", "boolean"] },
          "value": { "type": ["string", "number", "boolean"] },
          "unit": { "type": "string", "minLength": 1, "maxLength": 50 },
          "observed_at": { "$ref": "#/$defs/timestamp" },
          "source": {
            "type": "string",
            "enum": ["node_agent", "lstest_adapter", "device", "linux_log_read"]
          }
        }
      }
    },
    "failure_classification": {
      "type": "string",
      "enum": [
        "INVALID_INPUT",
        "INVALID_ENVIRONMENT",
        "INVALID_EVIDENCE",
        "VALID_FAILURE",
        "BLOCKED",
        "STOPPED",
        "UNSUPPORTED",
        "INFRA_ERROR"
      ],
      "description": "Authoritative failure vocabulary (C-02, 2026-10-29). These 8 uppercase values are the persisted truth; evidence-side failure_class is a lowercase serialization projection (bidirectional table in domain.md §9.4 and evidence-verdict.md §15.1). No failure is expressed by omitting this field (never by a NONE value). needs-review is not a member here; it is expressed by business_verdict=NEEDS_REVIEW plus non-PASS verification_status. INFRA_ERROR only after reconciliation confirms an infrastructure fault; heartbeat/communication timeout alone must never set it."
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "run_mode": { "const": "static" } }, "required": ["run_mode"] },
      "then": {
        "not": { "anyOf": [{ "required": ["node_id"] }, { "required": ["device_id"] }] },
        "properties": { "denominator_eligible": { "const": false } }
      }
    },
    {
      "if": { "properties": { "run_mode": { "const": "smoke" } }, "required": ["run_mode"] },
      "then": {
        "required": ["node_id", "device_id"],
        "properties": { "denominator_eligible": { "const": false } }
      }
    },
    {
      "if": { "properties": { "run_mode": { "const": "formal" } }, "required": ["run_mode"] },
      "then": {
        "required": ["node_id", "device_id"],
        "properties": { "evidence_origin": { "const": "real_device" } }
      }
    },
    {
      "if": {
        "properties": { "denominator_eligible": { "const": true } },
        "required": ["denominator_eligible"]
      },
      "then": {
        "properties": {
          "run_mode": { "const": "formal" },
          "evidence_origin": { "const": "real_device" },
          "execution_status": { "const": "COMPLETED" },
          "validity_status": { "const": "VALID" },
          "evidence_status": { "const": "COMPLETE" }
        }
      }
    },
    {
      "if": {
        "properties": { "flaky_suspect": { "const": true } },
        "required": ["flaky_suspect"]
      },
      "then": { "required": ["retry_of_attempt_id"] }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
