{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noahsark.invalid/contracts/domain/receipt.schema.json",
  "title": "NoahsArk Receipt",
  "description": "Node execution facts, device facts, cleanup reference and evidence references. A receipt never carries a final business verdict or verification status; only the Linux control plane writes those. Contract version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "job_id",
    "attempt",
    "job_kind",
    "task_id",
    "revision_id",
    "run_id",
    "bundle_id",
    "bundle_digest",
    "node_id",
    "execution_status",
    "node_facts",
    "anomaly_event_ids",
    "sequence",
    "signature",
    "chain_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "receipt_id": {
      "$ref": "#/$defs/uuid"
    },
    "job_id": {
      "$ref": "#/$defs/uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "job_kind": {
      "type": "string",
      "enum": [
        "static_check",
        "smoke",
        "formal",
        "stop_safe",
        "diagnostics",
        "cleanup"
      ],
      "description": "Protocol action and job_kind mapping is frozen in security-node.md 19.2 and domain.md 12.3. cleanup and diagnostics are auxiliary jobs; they never change Run.mode."
    },
    "task_id": {
      "$ref": "#/$defs/uuid"
    },
    "revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "bundle_id": {
      "$ref": "#/$defs/uuid"
    },
    "bundle_digest": {
      "$ref": "#/$defs/digest"
    },
    "node_id": {
      "$ref": "#/$defs/uuid"
    },
    "device_id": {
      "$ref": "#/$defs/uuid",
      "description": "Required for smoke/formal; omitted for static_check/diagnostics."
    },
    "lease_id": {
      "$ref": "#/$defs/uuid"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "RUNNING",
        "COMPLETED",
        "ABORTED",
        "SKIPPED"
      ],
      "description": "Execution axis only. Receipts must not contain business_verdict or verification_status."
    },
    "node_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "name",
          "value_type",
          "value",
          "observed_at",
          "source"
        ],
        "properties": {
          "fact_id": {
            "$ref": "#/$defs/uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "value_type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "observed_at": {
            "$ref": "#/$defs/timestamp"
          },
          "source": {
            "type": "string",
            "enum": [
              "node_agent",
              "lstest_adapter",
              "device",
              "linux_log_read"
            ]
          }
        }
      }
    },
    "anomaly_event_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uuid"
      },
      "uniqueItems": true
    },
    "evidence_manifest_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_digest"
      ],
      "properties": {
        "manifest_id": {
          "$ref": "#/$defs/uuid"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\.\\.).+$"
        }
      }
    },
    "cleanup_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanup_receipt_id",
        "cleanup_status",
        "local_stop_confirmed",
        "safe_cleanup_done",
        "occupancy_reconciled",
        "completed_at"
      ],
      "properties": {
        "cleanup_receipt_id": {
          "$ref": "#/$defs/uuid"
        },
        "cleanup_status": {
          "$ref": "#/$defs/cleanupStatus"
        },
        "local_stop_confirmed": {
          "type": "boolean"
        },
        "safe_cleanup_done": {
          "type": "boolean"
        },
        "occupancy_reconciled": {
          "type": "boolean"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "description": "Minimum device-release projection (R-02, 2026-10-29). security/receipt.schema.json cleanup_receipt is a superset of this object; this domain object carries only minimum release facts and rejects operational_detail via additionalProperties=false. Detailed cleanup steps/resources are authoritative in evidence/cleanup-receipt.schema.json. Missing cleanup receipt means occupancy is unreconciled, not that evidence is incomplete."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per node+job. Gaps must be backfilled and reconciled, never guessed."
    },
    "previous_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "nonce",
        "signed_payload_digest",
        "signature_value",
        "signed_at"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nonce": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "signed_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "signature_value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 8192
        },
        "signed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "chain_status": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "VALIDATED",
        "RECONCILED",
        "REJECTED"
      ]
    },
    "received_at": {
      "$ref": "#/$defs/timestamp"
    },
    "validated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 100
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "job_kind": {
            "enum": [
              "smoke",
              "formal"
            ]
          }
        },
        "required": [
          "job_kind"
        ]
      },
      "then": {
        "required": [
          "device_id",
          "lease_id",
          "lease_epoch",
          "cleanup_receipt"
        ]
      }
    }
  ],
  "$defs": {
    "cleanupStatus": {
      "type": "string",
      "enum": [
        "completed",
        "completed_with_warnings",
        "failed",
        "not_required",
        "unknown"
      ]
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  }
}
