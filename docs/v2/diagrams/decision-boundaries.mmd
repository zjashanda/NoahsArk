  F["阶段 8 自修复<br/>修复后重跑"]
  V["阶段 9 独立验证<br/>从原始证据重算"]
  D3{"重算一致?"}
  D4{"C1–C7 满足?<br/>C6 归档前补齐"}
  H3(["BLOCKED_HUMAN<br/>终态 · 等待人工"])
  C{"结论为 PASS?"}
  E(["PASS · 归档<br/>task.completed"])
  S(["STOPPED / CANCELLED / INFRA_ERROR<br/>保留证据，不产生产品结论"])
