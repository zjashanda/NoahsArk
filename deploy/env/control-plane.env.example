# NoahsArk control-plane environment template (V0.0.1 single host).
#
# Install:
#   install -d -m 0750 /etc/noahsark
#   install -m 0600 deploy/env/control-plane.env.example \
#           /etc/noahsark/control-plane.env
#   $EDITOR /etc/noahsark/control-plane.env
#
# Every value below is a placeholder. Replace CHANGE_ME and the OIDC values
# with real values from the operator's restricted records. Never commit the
# filled-in file. systemd reads this file as User=noahsark; it must not be
# world-readable.

APP_ENV=staging
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# pg_dump/psql cannot consume the asyncpg scheme directly; keep the app URL
# in SQLAlchemy form and let scripts/backup.sh rewrite it for pg_dump.
DATABASE_URL=postgresql+asyncpg://noahsark:CHANGE_ME@127.0.0.1:5432/noahsark

# G-AUTH is not closed. `oidc` fails closed until a real provider is wired.
# `dev_headers` is development-only and must not be used on a shared host.
AUTH_MODE=oidc
SESSION_TTL_SECONDS=3600
DEV_SESSION_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Evidence storage (P5-W3). Keep the root inside the API StateDirectory so
# `ProtectSystem=strict` permits writes. scripts/backup.sh archives this path.
EVIDENCE_STORAGE_ROOT=/var/lib/noahsark/evidence
EVIDENCE_MAX_BLOB_BYTES=1073741824
EVIDENCE_RETENTION_DAYS=30
