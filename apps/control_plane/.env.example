APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://noahsark:CHANGE_ME@127.0.0.1:5432/noahsark
API_PREFIX=/api/v1
LOG_LEVEL=INFO
AUTH_MODE=dev_headers
SESSION_TTL_SECONDS=3600
DEV_SESSION_ENABLED=true
# OIDC is a stub in W1 and fails closed until configured + implemented.
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# Local account bootstrap secrets. Do not put values in this file or in source.
# Supply them through hidden operator input, for example `make bootstrap-accounts`:
# NOAHSARK_ADMIN_PASSWORD
# NOAHSARK_OBSERVER_PASSWORD
