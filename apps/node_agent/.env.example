# NoahsArk Node Agent (development simulator) - copy to .env and fill values.
# Never commit real tokens, certificates, or device secrets.

# Control plane base URL (Linux side). The agent only makes outbound requests.
NOAHSARK_CONTROL_PLANE_URL=http://127.0.0.1:8000

# Node identity. Must be a UUID in production; this default is a dev-only value.
NOAHSARK_NODE_ID=00000000-0000-4000-8000-000000000001

# Bearer token issued by the control plane (dev placeholder only).
NOAHSARK_NODE_TOKEN=dev-node-token

# Node-local SQLite spool (queue of pending facts, not a source of authority).
NOAHSARK_SPOOL_PATH=./var/node_spool.sqlite3

# Artifact cache directory. Production artifact fetch/signature verification is PENDING.
NOAHSARK_ARTIFACT_CACHE_DIR=./var/artifacts

# Development-only HMAC signature hook. Leave empty to reject all signatures.
NOAHSARK_SIGNATURE_KEY_ID=simulator:hmac-dev
NOAHSARK_SIGNATURE_SECRET=

# Long-poll and heartbeat timing.
NOAHSARK_POLL_TIMEOUT_SECONDS=25
NOAHSARK_HEARTBEAT_INTERVAL_SECONDS=15
