      },
      "sansFallbackUI": {
        "value": "\"Microsoft YaHei UI\", \"Microsoft YaHei\", \"PingFang SC\", sans-serif",
        "description": "中文控件回退栈，仅当 Aptos/Segoe UI 缺字时使用"
      }
    },
    "scale": {
      "micro": { "size": "10px", "lineHeight": "14px", "letterSpacing": "0.14em", "usage": "全大写英文眉标，禁止中文正文" },
