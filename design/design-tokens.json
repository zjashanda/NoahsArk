  "typography": {
    "family": {
      "sans": {
        "value": "\"Aptos\", \"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", \"PingFang SC\", system-ui, sans-serif",
        "description": "中文正文优先，Windows 内网离线可用"
      },
      "display": {
        "value": "\"Sitka Banner\", \"Palatino Linotype\", \"Songti SC\", \"Source Han Serif SC\", \"SimSun\", serif",
        "description": "档案体：品牌字、页面标题、关键数字；每屏最多 4 处，不用于正文与控件"
      },
      "mono": {
        "value": "\"Cascadia Mono\", \"Cascadia Code\", Consolas, \"Courier New\", monospace",
