    },
    "patterns": {
      "hover": "background-color, border-color 120ms standard",
      "enterSheet": "opacity 180ms enter, translateY(3px -> 0) 180ms enter",
      "tabRule": "transform 180ms standard（下划线从 0 到目标宽度）",
      "drawer": "translateX(14px -> 0) + opacity 260ms enter",
      "toast": "translateY(6px -> 0) + opacity 180ms enter",
      "stampPress": "scale(0.985) 70ms standard，松开回弹 180ms stamp",
      "runningSheen": "仅运行中：2.2s linear infinite 的背景位移；减少动态时静止",
      "liveDot": "2.8s ease-in-out infinite opacity 1 -> 0.55；不作为唯一状态信号"
    },
    "reducedMotion": {
      "duration": "0.01ms",
      "behavior": "保留状态变化与进度数值，去除位移、脉冲、扫光、下划线生长动画与自动轮播"
    }
  },
  "iconography": {
    "style": "1.5px 描边、圆角端点、24 网格、无填充（状态点与品牌节点除外）",
    "sizes": { "xs": "14px", "sm": "16px", "md": "18px", "lg": "20px", "xl": "24px" },
    "strokeWidth": "1.5",
    "library": "本地内联 SVG，路径风格自绘；不使用 CDN，不使用图标字体",
    "rules": [
      "禁止 emoji 充当图标",
      "图标不得单独承载状态含义，必须配文字或 aria-label",
      "同一页面同一语义只用一个图标",
      "品牌 ark 标识不复用为普通图标"
    ]
  },
