  "motion": {
    "duration": {
      "instant": "70ms",
      "fast": "120ms",
      "base": "180ms",
      "slow": "260ms",
      "slower": "380ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.22, 0.61, 0.36, 1)",
