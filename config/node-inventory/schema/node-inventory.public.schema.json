{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noahsark.local/schema/node-inventory.public.schema.json",
  "title": "NoahsArk public node inventory (non-sensitive metadata only)",
  "description": "Commit-safe node inventory. It must never contain host addresses, usernames, passwords, private keys, tokens, or full SSH connection lines. Sensitive connection fields live only in the SOPS-encrypted inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "updated_at", "updated_by", "nodes"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "inventory_id": {"type": "string", "const": "noahsark-nodes-public"},
    "updated_at": {"type": "string", "format": "date-time"},
    "updated_by": {"type": "string", "minLength": 1, "maxLength": 64},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "ssh_alias",
        "os",
        "agent_id",
        "device_ids",
        "capabilities",
        "status",
        "last_seen_at",
        "last_verified_at",
        "last_verified_result",
        "config_version",
        "owner",
        "risk"
      ],
      "properties": {
        "node_id": {"$ref": "#/$defs/node_id"},
        "ssh_alias": {"$ref": "#/$defs/ssh_alias"},
        "os": {
          "type": "string",
          "enum": ["windows-11", "windows-server-2022", "linux", "other"]
        },
        "agent_id": {"type": ["string", "null"], "maxLength": 64},
        "device_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"}
        },
        "capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}
        },
        "status": {
          "type": "string",
          "enum": ["pending", "active", "blocked", "retired"]
        },
        "last_seen_at": {"type": ["string", "null"], "format": "date-time"},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "last_verified_result": {
          "type": "string",
          "enum": ["reachable", "timeout", "permission_denied", "error", "not_run"]
        },
        "config_version": {"type": "integer", "minimum": 0},
        "owner": {"type": ["string", "null"], "maxLength": 64},
        "risk": {"type": "string", "enum": ["low", "medium", "high", "unknown"]}
      }
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "ssh_alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    }
  }
}
